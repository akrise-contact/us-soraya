        "liquid_y8P9UC": {
          "type": "liquid",
          "settings": {
            "liquid": "<style>\n  .avika-offer {\n    max-width: 560px;\n    background: #f2f2f2;\n    border-radius: 14px;\n    padding: 8px 16px;\n    font-family: Inter, Arial, sans-serif;\n    color: #111;\n    margin-top: 10px;\n  }\n\n  .avika-offer__row {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n  }\n\n  .avika-offer__icon {\n    width: clamp(44px, 7vw, 60px);\n    height: clamp(44px, 7vw, 60px);\n    flex-shrink: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .avika-offer__icon img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    display: block;\n  }\n\n  .avika-offer__text {\n    font-size: clamp(13px, 1.6vw, 15px);\n    line-height: 1.35;\n    color: #111;\n    max-width: 420px;\n  }\n\n  .avika-offer__text strong {\n    font-weight: 700;\n  }\n\n  @media (max-width: 480px) {\n    .avika-offer {\n      padding: 6px 14px;\n      border-radius: 12px;\n    }\n    .avika-offer__text {\n      max-width: 100%;\n    }\n  }\n</style>\n\n{%- liquid\n  assign locale = request.locale.iso_code | downcase\n\n  assign t_today = \"Today only\"\n  assign t_free  = \"FREE earrings\"\n  assign t_end   = \"with this gift box\"\n  assign t_emoji = \" 🎁\"\n\n  if locale contains 'it'\n    assign t_today = \"Solo per oggi\"\n    assign t_free  = \"orecchini in OMAGGIO\"\n    assign t_end   = \"con l’acquisto di questo cofanetto\"\n  elsif locale contains 'es'\n    assign t_today = \"Solo por hoy\"\n    assign t_free  = \"pendientes GRATIS\"\n    assign t_end   = \"con la compra de este cofre\"\n  elsif locale contains 'de'\n    assign t_today = \"Nur heute\"\n    assign t_free  = \"Ohrringe GRATIS\"\n    assign t_end   = \"beim Kauf dieses Geschenksets\"\n  endif\n-%}\n\n<div class=\"avika-offer\" role=\"note\" aria-label=\"Today's offer\">\n  <div class=\"avika-offer__row\">\n    <div class=\"avika-offer__icon\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0969/9147/8097/files/Design_sans_titre_11.png?v=1768171085\"\n        alt=\"Free earrings\"\n        loading=\"lazy\"\n      >\n    </div>\n\n    <div class=\"avika-offer__text\">\n      <strong>{{ t_today }}</strong> – {{ t_free }} {{ t_end }}{{ t_emoji }}\n    </div>\n  </div>\n</div>"
          }
        },
        "liquid_E8QDrB": {
          "type": "liquid",
          "settings": {
            "liquid": "<div style=\"display:flex;align-items:center;gap:6px;font-family:Arial, sans-serif; margin-bottom: 12px;\">\n  <!-- Étoiles pleines -->\n  <div style=\"display:flex;align-items:center;\">\n    {% for i in (1..5) %}\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" fill=\"#800020\" viewBox=\"0 0 24 24\" style=\"margin-right:2px;\">\n        <path d=\"M12 .587l3.668 7.429 8.2 1.192-5.934 5.784 1.402 8.174L12 18.896l-7.336 3.87 1.402-8.174L.132 9.208l8.2-1.192z\"/>\n      </svg>\n    {% endfor %}\n  </div>\n  <!-- Texte des avis multilingue -->\n  <div style=\"font-size:14px;color:#333;\">\n    <strong>4.8/5</strong>\n    {% if request.locale.iso_code == 'fr' %}\n      (4,297 avis vérifiés)\n    {% elsif request.locale.iso_code == 'es' %}\n      (4,297 reseñas verificadas)\n    {% elsif request.locale.iso_code == 'it' %}\n      (4,297 recensioni verificate)\n    {% elsif request.locale.iso_code == 'de' %}\n      (4.297 verifizierte Bewertungen)\n    {% else %}\n      (4,297 verified reviews)\n    {% endif %}\n  </div>\n</div>"
          }
