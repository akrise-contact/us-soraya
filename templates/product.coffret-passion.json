    "faq_7ytpep": {
      "type": "faq",
      "blocks": {
        "item_gLAefw": {
          "type": "item",
          "settings": {
            "title": "Why is this gift so loved?",
            "content": "<p>Because it's not just an object: it symbolizes a unique bond, with your names engraved forever. A heartfelt gift she'll keep and wear with love. ❤️</p>"
          }
        },
        "item_ngf99X": {
          "type": "item",
          "settings": {
            "title": "What's included in my order?",
            "content": "<ul><li>An eternal rose bear</li><li>Your personalized necklace</li><li>A gift bag</li><li>A protective shipping box</li></ul><p><br/>Everything's included, nothing to add. It's ready to give. ✨</p>"
          }
        },
        "item_pVWjbG": {
          "type": "item",
          "settings": {
            "title": "Is the necklace water-resistant?",
            "content": "<p>Yes, 316L stainless steel plated with 18K gold. Resistant to water and sweat, and hypoallergenic.</p><p>She can wear it every day, even in the shower (although we recommend taking it off to extend the life of the gold plating).</p>"
          }
        },
        "item_eicLT8": {
          "type": "item",
          "settings": {
            "title": "What occasions is it perfect for?",
            "content": "<p>Any occasion. Birthdays, anniversaries, Mother's Day, Valentine's Day, Christmas, engagements, \"just because I love you\"...</p><p>The best gifts don't need an excuse. They come when you think of her. ❤️</p>"
          }
        },
        "item_CTEYdm": {
          "type": "item",
          "settings": {
            "title": "What if my jewelry arrives damaged?",
            "content": "<p>If your jewelry was damaged during shipping, we'll send you a new one at our expense!</p>"
          }
        },
        "item_ranF8z": {
          "type": "item",
          "settings": {
            "title": "What if I don't like it?",
            "content": "<p>Don't love it? Send us a message and we'll refund you, no questions asked!</p>"
          }
        },
        "item_ahqg6f": {
          "type": "item",
          "disabled": true,
          "settings": {
            "title": "What are your delivery times?",
            "content": "<p>All orders are packed, prepared and shipped within <strong>24–72 hours</strong>.</p><p>We offer fast worldwide shipping, and the usual delivery time is <strong>6 to 12 days</strong>. Depending on where you live, your items may arrive a little earlier or later.</p><p>Every order comes with a tracking number, so you can follow your package every step of the way.</p>"
          }
        }
      },
