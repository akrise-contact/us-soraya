    "testimonials_DBg9c3": {
      "type": "testimonials",
      "blocks": {
        "testimonial_tVL8Gd": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/pexels-italo-melo-881954-2379005.jpg",
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Julien R.",
            "title": "",
            "content": "<p>I was worried it would look cheap, but when the package arrived I was relieved. The bear is so cute, the rose is really beautiful, and my wife never expected to find the hidden necklace.</p>"
          }
        },
        "testimonial_jtzKYN": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/pexels-elletakesphotos-1680175.jpg",
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Lucas D.",
            "title": "",
            "content": "<p>Order with your eyes closed. All her friends asked me where I found it.</p>"
          }
        },
        "testimonial_n4yzQ7": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/pexels-divinetechygirl-1181424.jpg",
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Sophie M.",
            "title": "",
            "content": "<p>I ordered this bear for my daughter's 19th birthday. She burst into tears! The rose is gorgeous and the necklace is great quality. 100% recommend.</p>"
          }
        },
        "testimonial_KV4PWy": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/pexels-stefanstefancik-91227_c7f75afe-5e82-468b-b650-7e362a46d20b.jpg",
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Marc T.",
            "title": "",
            "content": "<p>My girlfriend told me it was the most beautiful gift she'd ever received. She put it right on her nightstand and wears the necklace every day. Honestly, for the price, it's a steal.</p>"
          }
        }
