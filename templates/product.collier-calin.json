        },
        "item_UPcreW": {
          "type": "item",
          "settings": {
            "title": "Can I give it for a special occasion?",
            "content": "<p>Any occasion. Birthdays, anniversaries, Valentine's Day, Christmas, engagements, \"just because I love you\"...</p><p>The best gifts don't need an excuse. They come when you think of her. ❤️</p>"
          }
        },
        "item_iefkmr": {
          "type": "item",
          "settings": {
            "title": "Can I shower with it?",
            "content": "<p><strong>Yes. </strong>The chain is made of high-quality stainless steel with real 18K gold plating. It's waterproof, doesn't tarnish and keeps its shine — even when worn every day.</p>"
          }
        },
        "item_6R8nNA": {
          "type": "item",
          "settings": {
            "title": "What if my jewelry arrives damaged?",
            "content": "<p>If your jewelry was damaged during shipping, we'll send you a new one at our expense!</p>"
