          "settings": {
            "liquid": "{%- assign gw_lang = request.locale.iso_code -%}\n\n{%- case gw_lang -%}\n  {%- when 'fr' -%}\n    {%- assign gw_t1 = 'Livraison gratuite' -%}\n    {%- assign gw_t2 = 'Bijoux garantis à vie' -%}\n    {%- assign gw_t3 = 'Support 7j/7' -%}\n    {%- assign gw_t4 = 'Paiement sécurisé' -%}\n  {%- when 'de' -%}\n    {%- assign gw_t1 = 'Kostenloser Versand' -%}\n    {%- assign gw_t2 = 'Schmuck mit lebenslanger Garantie' -%}\n    {%- assign gw_t3 = '7 Tage die Woche Support' -%}\n    {%- assign gw_t4 = 'Sichere Zahlung' -%}\n  {%- when 'es' -%}\n    {%- assign gw_t1 = 'Envío gratis' -%}\n    {%- assign gw_t2 = 'Joyas garantizadas de por vida' -%}\n    {%- assign gw_t3 = 'Soporte 7 días a la semana' -%}\n    {%- assign gw_t4 = 'Pago seguro' -%}\n  {%- when 'it' -%}\n    {%- assign gw_t1 = 'Spedizione gratuita' -%}\n    {%- assign gw_t2 = 'Gioielli garantiti a vita' -%}\n    {%- assign gw_t3 = 'Assistenza 7 giorni su 7' -%}\n    {%- assign gw_t4 = 'Pagamento sicuro' -%}\n  {%- else -%}\n    {%- assign gw_t1 = 'Free shipping' -%}\n    {%- assign gw_t2 = 'Jewelry guaranteed for life' -%}\n    {%- assign gw_t3 = '7-day support' -%}\n    {%- assign gw_t4 = 'Secure payment' -%}\n{%- endcase -%}\n\n<div class=\"gw-trust-badges\">\n  <div class=\"gw-badge\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"6\" width=\"14\" height=\"10\"></rect><path d=\"M15 9h4l3 3v4h-7z\"></path><circle cx=\"6\" cy=\"18\" r=\"1.6\"></circle><circle cx=\"17\" cy=\"18\" r=\"1.6\"></circle></svg>\n    <span>{{ gw_t1 }}</span>\n  </div>\n  <div class=\"gw-badge\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2l7 3v6c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V5z\"></path><path d=\"M9 12l2 2 4-4\"></path></svg>\n    <span>{{ gw_t2 }}</span>\n  </div>\n  <div class=\"gw-badge\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 13a9 9 0 0 1 18 0\"></path><path d=\"M21 13v4a2 2 0 0 1-2 2h-1\"></path><rect x=\"17\" y=\"13\" width=\"4\" height=\"6\" rx=\"1.5\"></rect><rect x=\"3\" y=\"13\" width=\"4\" height=\"6\" rx=\"1.5\"></rect></svg>\n    <span>{{ gw_t3 }}</span>\n  </div>\n  <div class=\"gw-badge\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"10\" rx=\"2\"></rect><path d=\"M8 10V7a4 4 0 0 1 8 0v3\"></path></svg>\n    <span>{{ gw_t4 }}</span>\n  </div>\n</div>\n\n<style>\n  .gw-trust-badges {\n    --gw-badge-bg: #F8ECEE;\n    --gw-badge-border: #D8A8AF;\n    --gw-badge-text: #5C1A2B;\n    --gw-badge-icon: #5C1A2B;\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 10px;\n    margin: 18px 0;\n  }\n  .gw-trust-badges .gw-badge {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    background: var(--gw-badge-bg);\n    border: 1px solid var(--gw-badge-border);\n    border-radius: 999px;\n    padding: 8px 16px;\n    font-size: 14px;\n    font-weight: 500;\n    line-height: 1.2;\n    color: var(--gw-badge-text);\n    white-space: nowrap;\n  }\n  .gw-trust-badges .gw-badge svg {\n    width: 19px;\n    height: 19px;\n    flex-shrink: 0;\n    color: var(--gw-badge-icon);\n  }\n  @media (max-width: 480px) {\n    .gw-trust-badges {\n      gap: 8px;\n    }\n    .gw-trust-badges .gw-badge {\n      font-size: 11.5px;\n      padding: 7px 12px;\n    }\n    .gw-trust-badges .gw-badge svg {\n      width: 17px;\n      height: 17px;\n    }\n  }\n</style>"
