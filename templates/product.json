        "liquid_VARkdh": {
          "type": "liquid",
          "disabled": true,
          "settings": {
            "liquid": "<div style=\"display:flex;justify-content:center;align-items:center;\nbackground:#f5f5f5;padding:8px 18px;border-radius:9999px;\nfont-family:Arial, sans-serif;font-size:13.5px;font-weight:700;\ncolor:#000;text-transform:uppercase;margin:auto;max-width:fit-content;\">\n  {% if request.locale.iso_code == 'es' %}Elegido el mejor regalo de 2025 🏆{% else %}Voted best gift of 2025 🏆{% endif %}\n</div>"
          }
        },
        "text_gf99Ta": {
          "type": "text",
          "settings": {
            "text": "<h2>Eternal Bear & Personalized Necklace</h2>"
          }
        },
        "liquid_9gHiLK": {
          "type": "liquid",
          "settings": {
            "liquid": "<div style=\"display:flex;align-items:center;gap:6px;font-family:Arial, sans-serif; margin-bottom: 12px;\">\n  <!-- Étoiles pleines -->\n  <div style=\"display:flex;align-items:center;\">\n    {% for i in (1..5) %}\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" fill=\"#800020\" viewBox=\"0 0 24 24\" style=\"margin-right:2px;\">\n        <path d=\"M12 .587l3.668 7.429 8.2 1.192-5.934 5.784 1.402 8.174L12 18.896l-7.336 3.87 1.402-8.174L.132 9.208l8.2-1.192z\"/>\n      </svg>\n    {% endfor %}\n  </div>\n  <!-- Texte des avis -->\n  <div style=\"font-size:14px;color:#333;\">\n    <strong>4.8/5</strong> {% if request.locale.iso_code == 'es' %}(1,318 reseñas verificadas){% else %}(1,318 verified reviews){% endif %}\n  </div>\n</div>\n\n<!-- Prix -->\n<div style=\"margin-bottom: 12px;\">\n  <div class=\"price-container\">\n    {%- assign sp_v = product.selected_or_first_available_variant -%}\n    <span class=\"sale-price\">{{ sp_v.price | money }}</span>\n    {%- if sp_v.compare_at_price > sp_v.price %}\n    <span class=\"compare-price\">{{ sp_v.compare_at_price | money }}</span>\n    {%- endif %}\n  </div>\n</div>\n\n<!-- Bullet points -->\n<ul style=\"list-style: none; padding: 0; margin: 0;\">\n  <li style=\"display: flex; align-items: center; margin-bottom: 8px;\">\n    <span style=\"color:#800020; font-size: 16px; margin-right: 4px;\">✿</span>\n    <span style=\"color: #000; font-weight: 600;\"> {% if request.locale.iso_code == 'es' %}Una joya cerca de su corazón cada día{% else %}A jewel close to her heart every day{% endif %}</span>\n  </li>\n  <li style=\"display: flex; align-items: center; margin-bottom: 8px;\">\n    <span style=\"color:#800020; font-size: 16px; margin-right: 6px;\">❀</span>\n    <span style=\"color: #000; font-weight: 600;\">{% if request.locale.iso_code == 'es' %}Un momento que nunca olvidará{% else %}A moment she'll never forget{% endif %}</span>\n  </li>\n  <li style=\"display: flex; align-items: center; margin-bottom: 8px;\">\n    <span style=\"color:#800020; font-size: 16px; margin-right: 6px;\">♡</span>\n    <span style=\"color: #000; font-weight: 600;\">{% if request.locale.iso_code == 'es' %}Sorpresa garantizada, recuerdo imborrable{% else %}Guaranteed surprise, lasting memory{% endif %}</span>\n  </li>\n</ul>\n\n<style>\n  .price-container {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .sale-price {\n    font-size: 24px;\n    font-weight: 600;\n    color: #800020;\n  }\n\n  .compare-price {\n    font-size: 18px;\n    color: #000;\n    text-decoration: line-through;\n  }\n</style>"
          }
        },
        "collapsible_text_E6xMtK": {
          "type": "collapsible_text",
          "settings": {
            "icon": "none",
            "icon_width": 20,
            "title": "Engraving ideas",
            "content": "<p><strong>Couple's initials (A+B, A ♡ B)</strong><br/>Simple, timeless, powerful.<br/><br/><strong>Names (Julie / David)</strong><br/>A declaration engraved forever.<br/><br/><strong>Special date (05/01/2014)</strong><br/>The day you met, your wedding, your moment.<br/><br/><strong>Roman numerals (V.XVI.MMXX)</strong><br/>Classic, sophisticated elegance.<br/><br/><strong>Romantic quotes:</strong><br/>- Forever / and always<br/>- You & Me / Forever<br/>- I love you / Always<br/><br/>Each quote is an engraved promise that captures the eternity of your feelings. Choose the ones that resonate most with your story.<br/><br/><strong>Symbols (♥❤♡✿❀✽★✯☆☘☾∞)</strong><br/>Express the inexpressible with symbols: heart, star, flower or infinity, adding a layer of emotion to your jewelry.<br/><br/>⚠️ Please only choose from the symbols listed to ensure an error-free engraving.<br/><br/>⚠️ The shorter your message, the more legible and refined the engraving. For the best result, keep it simple.<br/><br/></p>",
            "page": ""
          }
        },
