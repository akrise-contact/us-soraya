        "item_mP3d3L": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/fvzs1IMoz_mid.jpg",
            "column_size": "3",
            "title": "Marc L.",
            "heading_tag": "h4",
            "content": "<p>My girlfriend didn't see it coming at all! The surprise effect is amazing — it took her 5 minutes to figure out she had to turn the rose 😅 The necklace with the date we met engraved is perfect. Gift nailed!</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "item_P6jYc7": {
          "type": "item",
          "settings": {
