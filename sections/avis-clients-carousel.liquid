{%- comment -%}
  Section : Avis clients (carrousel compact)
  -----------------------------------------
  Tout est modifiable depuis l'éditeur de thème :
  - Réglages généraux (titre, note, nb d'avis)
  - Couleurs (accent, étoiles, badge, carte, texte)
  - Comportement du carrousel (défilement auto, vitesse, points)
  - Un bloc "Avis" par témoignage : photo, nom, étoiles, texte, badge
    → Ajoute / supprime / réordonne les avis directement dans l'éditeur.
{%- endcomment -%}

{%- assign review_blocks = section.blocks | where: "type", "review" -%}
{%- assign review_count = review_blocks | size -%}

<div class="ms-reviews-compact" style="--ms-max-width: {{ section.settings.max_width }}px;">

  {%- if section.settings.show_header -%}
    <div class="ms-reviews-compact-header">
      {%- if section.settings.heading != blank -%}
        <div class="ms-reviews-compact-title">{{ section.settings.heading }}</div>
      {%- endif -%}
      <div class="ms-reviews-compact-rating">
        <span class="ms-reviews-compact-stars">
          {%- for i in (1..5) -%}
            {%- if i <= section.settings.header_stars -%}★{%- else -%}☆{%- endif -%}
          {%- endfor -%}
        </span>
        <span class="ms-reviews-compact-score">{{ section.settings.rating_score }} • {{ section.settings.review_count_text }}</span>
      </div>
    </div>
  {%- endif -%}

  <div class="ms-reviews-compact-container">
    <div class="ms-reviews-compact-track">
      {%- for block in review_blocks -%}
        <div class="ms-review-compact-card" {{ block.shopify_attributes }}>
          <div class="ms-review-compact-content">
            <div class="ms-review-compact-top">
              <div class="ms-review-compact-photo">
                {%- if block.settings.photo -%}
                  <img
                    src="{{ block.settings.photo | image_url: width: 96 }}"
                    width="36" height="36"
                    alt="{{ block.settings.name | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="ms-review-compact-avatar-fallback">{{ block.settings.name | slice: 0, 1 }}</div>
                {%- endif -%}
              </div>
              <div class="ms-review-compact-author">
                <div class="ms-review-compact-name">{{ block.settings.name }}</div>
                <div class="ms-review-compact-stars-small">
                  {%- for i in (1..5) -%}
                    {%- if i <= block.settings.stars -%}★{%- else -%}☆{%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>

            <p class="ms-review-compact-text">{{ block.settings.text | escape | newline_to_br }}</p>

            {%- if block.settings.show_badge and block.settings.badge_text != blank -%}
              <span class="ms-review-compact-result">{{ block.settings.badge_icon }} {{ block.settings.badge_text }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_dots and review_count > 1 -%}
      <div class="ms-reviews-compact-dots">
        {%- for block in review_blocks -%}
          <button
            type="button"
            class="ms-reviews-compact-dot{% if forloop.index0 == 0 %} active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="Afficher l'avis {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .ms-reviews-compact {
    padding: 0;
    margin: 0;
    background-color: transparent;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .ms-reviews-compact-header {
    text-align: center;
    margin-bottom: 12px;
    padding-top: 20px;
  }

  #shopify-section-{{ section.id }} .ms-reviews-compact-title {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 14px;
    color: #666666;
    font-weight: 500;
    margin-bottom: 6px;
  }

  #shopify-section-{{ section.id }} .ms-reviews-compact-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .ms-reviews-compact-stars,
  #shopify-section-{{ section.id }} .ms-review-compact-stars-small {
    font-size: 13px;
    color: {{ section.settings.star_color }};
    letter-spacing: 1px;
  }

  #shopify-section-{{ section.id }} .ms-review-compact-stars-small {
    font-size: 10px;
    letter-spacing: 0.5px;
  }

  #shopify-section-{{ section.id }} .ms-reviews-compact-score {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #333333;
  }

  #shopify-section-{{ section.id }} .ms-reviews-compact-container {
    max-width: var(--ms-max-width, 800px);
    margin: 0 auto;
    overflow: hidden;
    padding: 0 15px;
  }

  #shopify-section-{{ section.id }} .ms-reviews-compact-track {
    display: flex;
    transition: transform {{ section.settings.slide_transition_speed }}s ease;
  }

  #shopify-section-{{ section.id }} .ms-review-compact-card {
    flex: 0 0 100%;
    padding: 0 5px;
  }

  #shopify-section-{{ section.id }} .ms-review-compact-content {
    background: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.border_radius }}px;
    padding: 15px 18px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    border: 1px solid {{ section.settings.card_border_color }};
  }

  #shopify-section-{{ section.id }} .ms-review-compact-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  #shopify-section-{{ section.id }} .ms-review-compact-photo {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid {{ section.settings.accent_color }};
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .ms-review-compact-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .ms-review-compact-avatar-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.accent_color }};
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ms-review-compact-author {
    flex-grow: 1;
  }

  #shopify-section-{{ section.id }} .ms-review-compact-name {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: {{ section.settings.name_color }};
    margin-bottom: 2px;
  }

  #shopify-section-{{ section.id }} .ms-review-compact-text {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    line-height: 1.4;
    color: {{ section.settings.text_color }};
    margin-bottom: 8px;
  }

  #shopify-section-{{ section.id }} .ms-review-compact-result {
    display: inline-block;
    background: {{ section.settings.badge_bg_color }};
    padding: 3px 8px;
    border-radius: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    color: {{ section.settings.badge_text_color }};
  }

  #shopify-section-{{ section.id }} .ms-reviews-compact-dots {
    display: flex;
    justify-content: center;
    gap: 5px;
    margin-top: 10px;
    padding-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .ms-reviews-compact-dot {
    width: 5px;
    height: 5px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: {{ section.settings.dot_color }};
    cursor: pointer;
    transition: all 0.3s ease;
  }

  #shopify-section-{{ section.id }} .ms-reviews-compact-dot.active {
    background: {{ section.settings.accent_color }};
    width: 16px;
    border-radius: 2.5px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .ms-reviews-compact-header {
      padding-top: 15px;
    }

    #shopify-section-{{ section.id }} .ms-review-compact-content {
      padding: 12px 15px;
    }

    #shopify-section-{{ section.id }} .ms-review-compact-text {
      font-size: 11px;
    }

    #shopify-section-{{ section.id }} .ms-reviews-compact-dots {
      padding-bottom: 15px;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    var track = root.querySelector('.ms-reviews-compact-track');
    var dots = root.querySelectorAll('.ms-reviews-compact-dot');
    var container = root.querySelector('.ms-reviews-compact-container');
    if (!track || !container) return;

    var totalReviews = {{ review_count }};
    var autoScrollEnabled = {{ section.settings.enable_autoscroll | json }};
    var pauseOnHover = {{ section.settings.pause_on_hover | json }};
    var autoScrollDelay = {{ section.settings.autoscroll_speed | times: 1000 }};
    var currentIndex = 0;
    var autoScrollTimer;

    function goToSlide(index) {
      currentIndex = index;
      track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
      dots.forEach(function (dot, i) {
        dot.classList.toggle('active', i === currentIndex);
      });
    }

    function nextSlide() {
      currentIndex = (currentIndex + 1) % totalReviews;
      goToSlide(currentIndex);
    }

    function startAutoScroll() {
      if (!autoScrollEnabled || totalReviews <= 1) return;
      stopAutoScroll();
      autoScrollTimer = setInterval(nextSlide, autoScrollDelay);
    }

    function stopAutoScroll() {
      if (autoScrollTimer) clearInterval(autoScrollTimer);
    }

    dots.forEach(function (dot, index) {
      dot.addEventListener('click', function () {
        goToSlide(index);
        startAutoScroll();
      });
    });

    if (pauseOnHover) {
      container.addEventListener('mouseenter', stopAutoScroll);
      container.addEventListener('mouseleave', startAutoScroll);
    }

    var touchStartX = 0;
    container.addEventListener('touchstart', function (e) {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoScroll();
    });

    container.addEventListener('touchend', function (e) {
      var touchEndX = e.changedTouches[0].screenX;
      if (touchEndX < touchStartX - 50) nextSlide();
      if (touchEndX > touchStartX + 50) {
        currentIndex = (currentIndex - 1 + totalReviews) % totalReviews;
        goToSlide(currentIndex);
      }
      startAutoScroll();
    });

    startAutoScroll();
  })();
</script>

{% schema %}
{
  "name": "Avis clients (carrousel)",
  "settings": [
    { "type": "header", "content": "Contenu général" },
    { "type": "checkbox", "id": "show_header", "label": "Afficher l'en-tête (titre + note)", "default": true },
    { "type": "text", "id": "heading", "label": "Titre au-dessus des étoiles", "default": "Avis vérifiés" },
    { "type": "text", "id": "rating_score", "label": "Note affichée", "default": "4,8/5" },
    { "type": "text", "id": "review_count_text", "label": "Texte du nombre d'avis", "default": "341 avis" },
    { "type": "range", "id": "header_stars", "label": "Nombre d'étoiles pleines (en-tête)", "min": 0, "max": 5, "step": 1, "default": 5 },

    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "accent_color", "label": "Couleur d'accent (contour photo, nom, point actif)", "default": "#800020" },
    { "type": "color", "id": "name_color", "label": "Couleur du nom de l'auteur", "default": "#800020" },
    { "type": "color", "id": "star_color", "label": "Couleur des étoiles", "default": "#C9A227" },
    { "type": "color", "id": "text_color", "label": "Couleur du texte de l'avis", "default": "#555555" },
    { "type": "color", "id": "card_bg_color", "label": "Couleur de fond des cartes", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border_color", "label": "Couleur de bordure des cartes", "default": "#F0F0F0" },
    { "type": "color", "id": "badge_bg_color", "label": "Couleur de fond du badge résultat", "default": "#FBF2E9" },
    { "type": "color", "id": "badge_text_color", "label": "Couleur du texte du badge", "default": "#800020" },
    { "type": "color", "id": "dot_color", "label": "Couleur des points (inactifs)", "default": "#D0D0D0" },

    { "type": "header", "content": "Mise en page" },
    { "type": "range", "id": "max_width", "label": "Largeur maximale du bloc (px)", "min": 400, "max": 1000, "step": 10, "default": 800 },
    { "type": "range", "id": "border_radius", "label": "Arrondi des cartes (px)", "min": 0, "max": 30, "step": 1, "default": 10 },

    { "type": "header", "content": "Carrousel" },
    { "type": "checkbox", "id": "enable_autoscroll", "label": "Activer le défilement automatique", "default": true },
    { "type": "range", "id": "autoscroll_speed", "label": "Vitesse de défilement (secondes)", "min": 2, "max": 10, "step": 1, "default": 3 },
    { "type": "range", "id": "slide_transition_speed", "label": "Vitesse de la transition (secondes)", "min": 0.2, "max": 1.5, "step": 0.1, "default": 0.5 },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Mettre en pause au survol (ordinateur)", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Afficher les points de navigation", "default": true }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo de l'auteur (facultatif)" },
        { "type": "text", "id": "name", "label": "Nom et âge", "default": "Sophie M., 34 ans" },
        { "type": "range", "id": "stars", "label": "Nombre d'étoiles", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Texte de l'avis", "default": "Je l'ai commandé pour la fête des mères et j'ai fondu en le voyant. La qualité est bien au-dessus du prix, et il ne noircit pas même porté tous les jours." },
        { "type": "checkbox", "id": "show_badge", "label": "Afficher le badge sous l'avis", "default": true },
        { "type": "text", "id": "badge_icon", "label": "Icône ou symbole du badge", "default": "❖" },
        { "type": "text", "id": "badge_text", "label": "Texte du badge", "default": "Porté chaque jour depuis 3 mois" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avis clients (carrousel)",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "name": "Sophie M., 34 ans",
            "stars": 5,
            "text": "Je l'ai commandé pour la fête des mères et j'ai fondu en le voyant. La qualité est bien au-dessus du prix, et il ne noircit pas même porté tous les jours.",
            "badge_icon": "❖",
            "badge_text": "Porté chaque jour depuis 3 mois"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Marie L., 41 ans",
            "stars": 5,
            "text": "Le coffret Rose Éternelle est magnifique, ma mère a pleuré en l'ouvrant. Livraison rapide et le collier est encore plus beau en vrai qu'en photo.",
            "badge_icon": "🎁",
            "badge_text": "Offert en cadeau"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Léa D., 29 ans",
            "stars": 5,
            "text": "Douche, sport, sommeil : je ne l'enlève jamais et il n'a pas bougé. La chaîne est réglable donc il tombe parfaitement sur la clavicule.",
            "badge_icon": "✧",
            "badge_text": "Imperméable, aucune trace"
          }
        }
      ]
    }
  ]
}
{% endschema %}
