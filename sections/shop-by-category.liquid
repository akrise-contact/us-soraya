{%- comment -%}
  SECTION : Vitrine collections (Shop by category)
  --------------------------------------------------
  - 2 colonnes sur mobile (grille OU glissement horizontal au choix),
    jusqu'à 6 colonnes sur ordinateur
  - Chaque bloc peut pointer vers une VRAIE collection de votre boutique
    (image + titre + lien automatiques) OU être 100% personnalisé
    (votre propre image, titre et lien)
  - Réglages : titre de section, couleurs, tailles, espacements, ratio
    d'image, coins arrondis, texte sur l'image OU en dessous, filtre
    sombre sur l'image activable, effet zoom au survol, etc.

  INSTALLATION :
  1) Enregistrez ce fichier sous : sections/shop-by-category.liquid
  2) Dans l'éditeur de thème (Personnaliser) : allez sur la page voulue
     > "Ajouter une section" > "Vitrine collections"
  3) Pour chaque bloc "Catégorie" : ouvrez son réglage "Collection" et
     choisissez votre collection (Colliers, Bagues, Bracelets, Coffrets...).
     L'image et le titre se remplissent alors automatiquement — vous
     pouvez toujours les remplacer par vos propres image/titre si besoin.
{%- endcomment -%}

{%- assign s = section.settings -%}

{%- assign overlay_opacity_decimal = s.overlay_opacity | divided_by: 100.0 -%}
{%- assign label_bg_alpha = s.label_background_opacity | divided_by: 100.0 -%}
{%- assign label_bg_rgba = s.label_background_color | color_modify: 'alpha', label_bg_alpha -%}

{%- case s.label_weight -%}
  {%- when 'normal' -%}{%- assign label_font_weight = 400 -%}
  {%- when 'medium' -%}{%- assign label_font_weight = 500 -%}
  {%- when 'semibold' -%}{%- assign label_font_weight = 600 -%}
  {%- else -%}{%- assign label_font_weight = 700 -%}
{%- endcase -%}

<div class="category-showcase category-showcase-{{ section.id }}">
  <div class="page-width">

    {%- if s.show_divider -%}<div class="category-showcase__divider"></div>{%- endif -%}

    {%- if s.show_heading and s.heading != blank -%}
      <h2 class="category-showcase__heading">{{ s.heading | escape }}</h2>
    {%- endif -%}

    <div class="category-grid category-grid--{{ s.mobile_layout }}">
      {%- for block in section.blocks -%}
        {%- assign card_url = '' -%}
        {%- assign card_title = '' -%}
        {%- assign card_image = nil -%}

        {%- if block.settings.collection != blank -%}
          {%- assign card_url = block.settings.collection.url -%}
          {%- assign card_title = block.settings.collection.title -%}
          {%- if block.settings.collection.image -%}
            {%- assign card_image = block.settings.collection.image -%}
          {%- endif -%}
        {%- elsif block.settings.custom_link != blank -%}
          {%- assign card_url = block.settings.custom_link -%}
        {%- endif -%}

        {%- if block.settings.custom_title != blank -%}
          {%- assign card_title = block.settings.custom_title -%}
        {%- endif -%}
        {%- if block.settings.custom_image -%}
          {%- assign card_image = block.settings.custom_image -%}
        {%- endif -%}

        {%- assign ph_index = forloop.index | modulo: 6 | plus: 1 -%}
        {%- assign ph_key = 'collection-' | append: ph_index -%}

        {%- capture card_inner -%}
          <div class="category-card__image-wrap">
            {%- if card_image -%}
              <img
                src="{{ card_image | image_url: width: 900 }}"
                srcset="{{ card_image | image_url: width: 450 }} 450w, {{ card_image | image_url: width: 900 }} 900w"
                sizes="(min-width: 750px) 25vw, 50vw"
                alt="{{ card_title | escape }}"
                loading="lazy"
              >
            {%- else -%}
              {{ ph_key | placeholder_svg_tag: 'category-card__placeholder' }}
            {%- endif -%}

            {%- if s.enable_overlay -%}
              <span class="category-card__overlay"></span>
            {%- endif -%}

            {%- if card_title != blank and s.text_position != 'below' -%}
              <span class="category-card__label">{{ card_title }}</span>
            {%- endif -%}
          </div>

          {%- if card_title != blank and s.text_position == 'below' -%}
            <span class="category-card__label">{{ card_title }}</span>
          {%- endif -%}
        {%- endcapture -%}

        {%- if card_url != blank -%}
          <a href="{{ card_url }}" class="category-card category-card--{{ s.text_position }}" {{ block.shopify_attributes }}>
            {{ card_inner }}
          </a>
        {%- else -%}
          <div class="category-card category-card--{{ s.text_position }}" {{ block.shopify_attributes }}>
            {{ card_inner }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{%- style -%}
  .category-showcase-{{ section.id }} {
    background-color: {{ s.background_color }};
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
  }

  .category-showcase-{{ section.id }} .category-showcase__divider {
    border-top: 1px solid rgba(0,0,0,.08);
    margin-bottom: {{ s.padding_top | divided_by: 2 }}px;
  }

  .category-showcase-{{ section.id }} .category-showcase__heading {
    text-align: {{ s.heading_alignment }};
    color: {{ s.heading_color }};
    font-size: {{ s.heading_size }}px;
    letter-spacing: {{ s.heading_letter_spacing }}px;
    text-transform: {% if s.heading_uppercase %}uppercase{% else %}none{% endif %};
    margin: 0 0 {{ s.gap | times: 1.2 }}px 0;
    font-weight: 600;
    line-height: 1.2;
  }

  .category-showcase-{{ section.id }} .category-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .category-showcase-{{ section.id }} .category-card__image-wrap {
    position: relative;
    overflow: hidden;
    border-radius: {{ s.image_radius }}px;
    aspect-ratio: {{ s.image_aspect_ratio }};
    background-color: #e8e8e8;
  }

  .category-showcase-{{ section.id }} .category-card__image-wrap img,
  .category-showcase-{{ section.id }} .category-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .4s ease;
  }

  {%- if s.enable_hover_zoom -%}
    .category-showcase-{{ section.id }} .category-card:hover img,
    .category-showcase-{{ section.id }} .category-card:hover .category-card__placeholder {
      transform: scale(1.06);
    }
  {%- endif -%}

  .category-showcase-{{ section.id }} .category-card__overlay {
    position: absolute;
    inset: 0;
    background-color: {{ s.overlay_color }};
    opacity: {{ overlay_opacity_decimal }};
    pointer-events: none;
  }

  .category-showcase-{{ section.id }} .category-card__label {
    display: block;
    color: {{ s.label_text_color }};
    font-size: {{ s.label_font_size }}px;
    letter-spacing: {{ s.label_letter_spacing }}px;
    font-weight: {{ label_font_weight }};
    text-transform: {% if s.label_uppercase %}uppercase{% else %}none{% endif %};
    text-align: {{ s.label_alignment }};
    line-height: 1.35;
    {%- if s.show_label_background -%}
      background-color: {{ label_bg_rgba }};
      padding: {{ s.label_padding }}px;
    {%- endif -%}
  }

  .category-showcase-{{ section.id }} .category-card--overlay_bottom .category-card__label {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
  }

  .category-showcase-{{ section.id }} .category-card--overlay_center .category-card__label {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
  }

  .category-showcase-{{ section.id }} .category-card--below .category-card__label {
    margin-top: 14px;
  }

  {%- if s.mobile_layout == 'scroll' -%}
    .category-showcase-{{ section.id }} .category-grid {
      display: flex;
      gap: {{ s.gap }}px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 6px;
      scrollbar-width: none;
    }
    .category-showcase-{{ section.id }} .category-grid::-webkit-scrollbar {
      display: none;
    }
    .category-showcase-{{ section.id }} .category-card {
      flex: 0 0 calc(50% - {{ s.gap | divided_by: 2.0 }}px);
      scroll-snap-align: start;
    }
  {%- else -%}
    .category-showcase-{{ section.id }} .category-grid {
      display: grid;
      grid-template-columns: repeat({{ s.columns_mobile }}, 1fr);
      gap: {{ s.gap }}px;
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    .category-showcase-{{ section.id }} .category-grid {
      display: grid;
      grid-template-columns: repeat({{ s.columns_desktop }}, 1fr);
      overflow-x: visible;
    }
    .category-showcase-{{ section.id }} .category-card {
      flex: none;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Vitrine collections",
  "tag": "section",
  "class": "section-category-showcase-wrapper",
  "settings": [
    { "type": "header", "content": "Titre" },
    { "type": "checkbox", "id": "show_heading", "label": "Afficher le titre", "default": true },
    { "type": "text", "id": "heading", "label": "Texte du titre", "default": "Nos Collections" },
    { "type": "range", "id": "heading_size", "label": "Taille du titre", "min": 18, "max": 56, "step": 1, "unit": "px", "default": 32 },
    { "type": "color", "id": "heading_color", "label": "Couleur du titre", "default": "#6E1F2E" },
    { "type": "checkbox", "id": "heading_uppercase", "label": "Titre en majuscules", "default": true },
    { "type": "range", "id": "heading_letter_spacing", "label": "Espacement des lettres du titre", "min": 0, "max": 8, "step": 0.5, "unit": "px", "default": 2 },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignement du titre",
      "options": [
        { "value": "center", "label": "Centré" },
        { "value": "left", "label": "Gauche" }
      ],
      "default": "center"
    },
    { "type": "checkbox", "id": "show_divider", "label": "Afficher une ligne de séparation au-dessus", "default": false },

    { "type": "header", "content": "Mise en page" },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Colonnes (ordinateur)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Affichage mobile",
      "options": [
        { "value": "grid", "label": "Grille fixe" },
        { "value": "scroll", "label": "Glissement horizontal (swipe)" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Colonnes (mobile, si grille fixe)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    { "type": "range", "id": "gap", "label": "Espacement entre les blocs", "min": 4, "max": 48, "step": 2, "unit": "px", "default": 20 },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Format des images",
      "options": [
        { "value": "1 / 1", "label": "Carré" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 4", "label": "Portrait allongé" },
        { "value": "16 / 9", "label": "Paysage" },
        { "value": "auto", "label": "Format d'origine" }
      ],
      "default": "1 / 1"
    },
    { "type": "range", "id": "image_radius", "label": "Coins arrondis des images", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "checkbox", "id": "enable_hover_zoom", "label": "Effet de zoom au survol", "default": true },
    { "type": "color", "id": "background_color", "label": "Couleur de fond de la section", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Marge intérieure haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Marge intérieure basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },

    { "type": "header", "content": "Filtre sur l'image" },
    { "type": "checkbox", "id": "enable_overlay", "label": "Assombrir/teinter les images", "default": false },
    { "type": "color", "id": "overlay_color", "label": "Couleur du filtre", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Intensité du filtre", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },

    { "type": "header", "content": "Texte de chaque bloc" },
    {
      "type": "select",
      "id": "text_position",
      "label": "Position du texte",
      "options": [
        { "value": "overlay_bottom", "label": "Sur l'image, en bas" },
        { "value": "overlay_center", "label": "Sur l'image, centré" },
        { "value": "below", "label": "Sous l'image" }
      ],
      "default": "overlay_bottom"
    },
    {
      "type": "select",
      "id": "label_alignment",
      "label": "Alignement du texte",
      "options": [
        { "value": "center", "label": "Centré" },
        { "value": "left", "label": "Gauche" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "label_font_size", "label": "Taille du texte", "min": 10, "max": 28, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "label_letter_spacing", "label": "Espacement des lettres", "min": 0, "max": 6, "step": 0.5, "unit": "px", "default": 1 },
    { "type": "checkbox", "id": "label_uppercase", "label": "Texte en majuscules", "default": true },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Graisse du texte",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "medium", "label": "Medium" },
        { "value": "semibold", "label": "Semi-gras" },
        { "value": "bold", "label": "Gras" }
      ],
      "default": "medium"
    },
    { "type": "color", "id": "label_text_color", "label": "Couleur du texte", "default": "#1A1A1A" },
    { "type": "checkbox", "id": "show_label_background", "label": "Fond derrière le texte", "default": true },
    { "type": "color", "id": "label_background_color", "label": "Couleur du fond du texte", "default": "#FFFFFF" },
    { "type": "range", "id": "label_background_opacity", "label": "Opacité du fond du texte", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "label_padding", "label": "Espace intérieur du fond du texte", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Remplit automatiquement l'image, le titre et le lien." },
        { "type": "image_picker", "id": "custom_image", "label": "Image personnalisée", "info": "Laissez vide pour utiliser l'image de la collection." },
        { "type": "text", "id": "custom_title", "label": "Titre personnalisé", "info": "Laissez vide pour utiliser le titre de la collection." },
        { "type": "url", "id": "custom_link", "label": "Lien personnalisé", "info": "Utilisé seulement si aucune collection n'est sélectionnée." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vitrine collections",
      "blocks": [
        { "type": "category", "settings": { "custom_title": "Colliers" } },
        { "type": "category", "settings": { "custom_title": "Bagues" } },
        { "type": "category", "settings": { "custom_title": "Bracelets" } },
        { "type": "category", "settings": { "custom_title": "Coffrets" } }
      ]
    }
  ]
}
{% endschema %}
