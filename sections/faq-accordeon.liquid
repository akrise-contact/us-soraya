{% comment %}
  Section "FAQ Accordéon"
  - Tout est modifiable depuis le personnalisateur de thème : titre, sous-titre,
    couleurs, catégories et questions/réponses (blocs), et la possibilité
    d'imposer une police différente si tu le souhaites.
  - Par défaut, AUCUNE police n'est forcée : le texte hérite automatiquement
    de la police déjà utilisée sur ton site. Si tu veux une police différente
    juste pour cette section, active "Utiliser des polices personnalisées"
    ci-dessous dans les réglages de la section.
{% endcomment %}

<div class="faq-section faq-section-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h1 class="faq-title">{{ section.settings.heading }}</h1>
  {% endif %}
  {% if section.settings.subheading != blank %}
    <div class="faq-subtitle">{{ section.settings.subheading }}</div>
  {% endif %}

  {% assign category_open = false %}
  {% for block in section.blocks %}
    {% case block.type %}

      {% when 'category' %}
        {% if category_open %}
          </div>
        {% endif %}
        <div class="faq-category" {{ block.shopify_attributes }}>
          <h2 class="faq-category-title">{{ block.settings.title }}</h2>
        {% assign category_open = true %}

      {% when 'question' %}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary class="faq-question">
            <span>{{ block.settings.question }}</span>
            <span class="faq-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">{{ block.settings.answer }}</div>
        </details>

      {% when 'text' %}
        <div class="faq-closing" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>

    {% endcase %}
  {% endfor %}
  {% if category_open %}
    </div>
  {% endif %}
</div>

{% if section.settings.override_fonts %}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {% unless section.settings.body_font == section.settings.heading_font %}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {% endunless %}
{% endif %}

<style>
  .faq-section-{{ section.id }} {
    --faq-accent: {{ section.settings.accent_color }};
    --faq-text: {{ section.settings.text_color }};
    --faq-muted: {{ section.settings.muted_text_color }};
    --faq-border: {{ section.settings.border_color }};
    background-color: {{ section.settings.background_color }};
    max-width: 700px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
  {% if section.settings.override_fonts %}
    .faq-section-{{ section.id }} .faq-title,
    .faq-section-{{ section.id }} .faq-category-title,
    .faq-section-{{ section.id }} .faq-question {
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    }
    .faq-section-{{ section.id }} .faq-subtitle,
    .faq-section-{{ section.id }} .faq-answer,
    .faq-section-{{ section.id }} .faq-closing {
      font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    }
  {% endif %}
  .faq-section-{{ section.id }} .faq-title {
    text-align: center;
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 16px;
    color: var(--faq-text);
  }
  .faq-section-{{ section.id }} .faq-subtitle {
    text-align: center;
    font-size: 16px;
    line-height: 1.5;
    color: var(--faq-muted);
    margin: 0 0 48px;
  }
  .faq-section-{{ section.id }} .faq-category { margin-bottom: 40px; }
  .faq-section-{{ section.id }} .faq-category-title {
    text-align: center;
    font-size: 24px;
    font-weight: 600;
    color: var(--faq-text);
    margin: 0 0 16px;
  }
  .faq-section-{{ section.id }} .faq-item {
    border-top: 1px solid var(--faq-border);
  }
  .faq-section-{{ section.id }} .faq-item:last-child {
    border-bottom: 1px solid var(--faq-border);
  }
  .faq-section-{{ section.id }} .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 4px;
    font-size: 17px;
    color: var(--faq-text);
    cursor: pointer;
    list-style: none;
  }
  .faq-section-{{ section.id }} .faq-question::-webkit-details-marker { display: none; }
  .faq-section-{{ section.id }} .faq-icon {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    color: var(--faq-text);
    transition: transform 0.25s ease;
  }
  .faq-section-{{ section.id }} .faq-icon svg { width: 100%; height: 100%; }
  .faq-section-{{ section.id }} details[open] .faq-icon { transform: rotate(180deg); }
  .faq-section-{{ section.id }} .faq-answer {
    font-size: 15px;
    line-height: 1.6;
    color: var(--faq-muted);
    padding: 0 4px 20px;
  }
  .faq-section-{{ section.id }} .faq-answer p { margin: 0 0 12px; }
  .faq-section-{{ section.id }} .faq-answer p:last-child { margin-bottom: 0; }
  .faq-section-{{ section.id }} .faq-answer a { color: var(--faq-accent); text-decoration: underline; }
  .faq-section-{{ section.id }} .faq-closing {
    font-size: 15px;
    line-height: 1.6;
    color: var(--faq-muted);
    text-align: center;
    margin: 0 0 20px;
  }
</style>

{% schema %}
{
  "name": "FAQ Accordéon",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "FAQ & Contact"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "<p>La réponse à votre question se trouve probablement dans la FAQ suivante 👍</p>"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte (titres, questions)",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Couleur du texte (réponses, sous-titre)",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent (liens)",
      "default": "#800020"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Couleur des séparateurs",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace au-dessus",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en-dessous",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Police"
    },
    {
      "type": "paragraph",
      "content": "Par défaut, cette section utilise déjà la police de ton thème. Active l'option ci-dessous seulement si tu veux une police différente pour cette section précise."
    },
    {
      "type": "checkbox",
      "id": "override_fonts",
      "label": "Utiliser des polices personnalisées pour cette section",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Police des titres",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Police du texte",
      "default": "assistant_n4"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre de la catégorie",
          "default": "Nouvelle catégorie"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Votre question ici"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Votre réponse ici.</p>"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texte libre",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenu",
          "default": "<p>Texte libre.</p>"
        }
      ]
    }
  ],
