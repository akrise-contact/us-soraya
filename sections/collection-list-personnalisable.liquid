{%- comment -%}
  Collection list — version personnalisable (autonome, sans dépendance externe)
  ------------------------------------------------
  IMPORTANT : le fichier d'origine appelait un snippet "collection-grid-item" qui n'existe
  pas dans votre thème (c'est l'erreur que vous avez eue). Cette version construit directement
  la carte de chaque collection dans ce fichier, donc plus besoin de ce snippet manquant.

  Nouveautés :
  - Nombre de collections par ligne sur mobile, indépendant du réglage desktop/tablette
  - Padding haut/bas de la section
  - Couleur de fond de section, couleur du titre de section, couleur du séparateur
  - Taille et alignement du titre de section
  - Format de l'image de chaque collection (carré / portrait / paysage / original)
  - Arrondi des coins des cartes
  - Position du titre de collection : par-dessus l'image (avec voile de couleur réglable) ou en dessous
  - Couleur et taille du titre de chaque carte

  À copier-coller dans votre fichier Shopify existant, à la place du contenu actuel.
{%- endcomment -%}

<style>
  {%- if section.settings.background != blank %}
    #shopify-section-{{ section.id }} {
      background: {{ section.settings.background }};
    }
  {%- endif %}

  {%- if section.settings.section_padding_top > 0 or section.settings.section_padding_bottom > 0 %}
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.section_padding_top }}px;
      padding-bottom: {{ section.settings.section_padding_bottom }}px;
    }
  {%- endif %}

  {%- if section.settings.text_color != blank %}
    #shopify-section-{{ section.id }} .section-header__title {
      color: {{ section.settings.text_color }};
    }
  {%- endif %}

  {%- if section.settings.divider_color != blank %}
    #shopify-section-{{ section.id }} .section--divider {
      border-color: {{ section.settings.divider_color }};
      background-color: {{ section.settings.divider_color }};
    }
  {%- endif %}

  {%- case section.settings.heading_size %}
    {%- when 'small' %}
      {%- assign heading_font_size = 20 %}
    {%- when 'large' %}
      {%- assign heading_font_size = 36 %}
    {%- when 'xlarge' %}
      {%- assign heading_font_size = 44 %}
    {%- else %}
      {%- assign heading_font_size = 28 %}
  {%- endcase %}

  #shopify-section-{{ section.id }} .section-header__title {
    font-size: {{ heading_font_size }}px;
  }

  {%- if section.settings.heading_alignment == 'center' %}
    #shopify-section-{{ section.id }} .section-header {
      text-align: center;
    }
  {%- endif %}

  {%- case section.settings.image_aspect_ratio %}
    {%- when 'square' %}
      {%- assign card_aspect_ratio = '1 / 1' %}
    {%- when 'portrait' %}
      {%- assign card_aspect_ratio = '3 / 4' %}
    {%- when 'landscape' %}
      {%- assign card_aspect_ratio = '4 / 3' %}
    {%- else %}
      {%- assign card_aspect_ratio = 'auto' %}
  {%- endcase %}

  #shopify-section-{{ section.id }} .cl-card__image-wrapper {
    aspect-ratio: {{ card_aspect_ratio }};
    border-radius: {{ section.settings.card_border_radius }}px;
  }

  #shopify-section-{{ section.id }} .cl-card__overlay {
    background: {{ section.settings.overlay_color | default: '#000000' }};
    opacity: {{ section.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};
  }

  {%- case section.settings.card_title_size %}
    {%- when 'small' %}
      {%- assign card_title_font_size = 16 %}
    {%- when 'large' %}
      {%- assign card_title_font_size = 28 %}
    {%- else %}
      {%- assign card_title_font_size = 20 %}
  {%- endcase %}

  #shopify-section-{{ section.id }} .cl-card__title {
    font-size: {{ card_title_font_size }}px;
    {%- if section.settings.card_title_color != blank %}
      color: {{ section.settings.card_title_color }};
    {%- endif %}
  }

  #shopify-section-{{ section.id }} .cl-card__image-wrapper {
    position: relative;
    overflow: hidden;
    display: block;
    background: #f3f3f3;
  }

  #shopify-section-{{ section.id }} .cl-card__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .cl-card__overlay {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .cl-card--overlay .cl-card__title {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .cl-card--below .cl-card__title {
    display: block;
    padding-top: 12px;
    text-align: center;
  }
</style>

{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

<div class="page-width">
  {%- if section.settings.title != blank -%}
    <div class="section-header">
      <h2 class="section-header__title">{{ section.settings.title }}</h2>
    </div>
  {%- endif -%}

  <div class="grid grid--uniform{% unless section.settings.enable_gutter %} grid--no-gutters{% endunless %}">
    {%- liquid
      assign isEmpty = true
      if section.blocks.size > 0
        assign isEmpty = false
      endif

      assign mobile_class = ''
      if section.settings.per_row_mobile == '2'
        assign mobile_class = 'small--one-half '
      endif
    -%}

    {%- for block in section.blocks -%}
      {%- liquid
        assign collection = collections[block.settings.collection]
        assign background_position = block.settings.focal_point | default: 'center center'
        assign card_title = block.settings.title | default: collection.title

        assign desktop_class = ''
        case section.settings.per_row
          when 2
            assign desktop_class = 'medium-up--one-half'
          when 3
            assign desktop_class = 'medium-up--one-third'
          when 4
            assign desktop_class = 'medium-up--one-quarter'
          when 5
            assign desktop_class = 'medium-up--one-fifth'
        endcase

        assign grid_item_width = mobile_class | append: desktop_class
      -%}

      <div class="grid__item {{ grid_item_width }}" {{ block.shopify_attributes }}>
        {%- if collection -%}
          <a href="{{ collection.url }}" class="cl-card {% if section.settings.title_position == 'below' %}cl-card--below{% else %}cl-card--overlay{% endif %}">
            <div class="cl-card__image-wrapper">
              {%- capture image_style -%}object-position: {{ background_position }};{%- endcapture -%}

              {%- if collection.image -%}
                {{- collection.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 25vw, 50vw', style: image_style -}}
              {%- elsif collection.products.first.featured_image -%}
                {{- collection.products.first.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 25vw, 50vw', style: image_style -}}
              {%- else -%}
                {{- 'collection-1' | placeholder_svg_tag: 'placeholder-svg' -}}
              {%- endif -%}

              {%- if section.settings.title_position != 'below' -%}
                <div class="cl-card__overlay"></div>
              {%- endif -%}

              {%- if section.settings.title_position != 'below' -%}
                <div class="cl-card__title">{{ card_title }}</div>
              {%- endif -%}
            </div>

            {%- if section.settings.title_position == 'below' -%}
              <div class="cl-card__title">{{ card_title }}</div>
            {%- endif -%}
          </a>
        {%- else -%}
          <div class="cl-card cl-card--below">
            <div class="cl-card__image-wrapper">
              {{- 'collection-1' | placeholder_svg_tag: 'placeholder-svg' -}}
            </div>
            <div class="cl-card__title">Select a collection</div>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}

    {%- if isEmpty -%}
      <div class="page-width">
        <div class="grid">
          <div class="grid__item">
            <div class="rte">
              {{ 'home_page.onboarding.no_content' | t }}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

{%- if section.settings.divider -%}</div>{%- endif -%}

{% schema %}
  {
    "name": "Collection list",
    "class": "index-section",
    "max_blocks": 15,
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Collection list"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "per_row",
        "label": "Collections per row (tablet & desktop)",
        "default": 4,
        "min": 2,
        "max": 5,
        "step": 1
      },
      {
        "type": "select",
        "id": "per_row_mobile",
        "label": "Collections per row (mobile)",
        "options": [
          { "value": "1", "label": "1" },
          { "value": "2", "label": "2" }
        ],
        "default": "2"
      },
      {
        "type": "checkbox",
        "id": "enable_gutter",
        "label": "Add spacing between collections",
        "default": true
      },
      {
        "type": "header",
        "content": "Section spacing"
      },
      {
        "type": "range",
        "id": "section_padding_top",
        "label": "Top padding",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "section_padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "divider",
        "label": "Show section divider",
        "default": false
      },
      {
        "type": "header",
        "content": "Heading style"
      },
      {
        "type": "select",
        "id": "heading_size",
        "label": "Heading size",
        "options": [
          { "value": "small", "label": "Small (20px)" },
          { "value": "medium", "label": "Medium (28px)" },
          { "value": "large", "label": "Large (36px)" },
          { "value": "xlarge", "label": "Extra large (44px)" }
        ],
        "default": "medium"
      },
      {
        "type": "select",
        "id": "heading_alignment",
        "label": "Heading alignment",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Center" }
        ],
        "default": "left"
      },
      {
        "type": "header",
        "content": "Collection card style"
      },
      {
        "type": "select",
        "id": "image_aspect_ratio",
        "label": "Image format",
        "options": [
          { "value": "square", "label": "Square (1:1)" },
          { "value": "portrait", "label": "Portrait (3:4)" },
          { "value": "landscape", "label": "Landscape (4:3)" },
          { "value": "original", "label": "Original image" }
        ],
        "default": "square"
      },
      {
        "type": "range",
        "id": "card_border_radius",
        "label": "Card corner radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "select",
        "id": "title_position",
        "label": "Collection title position",
        "options": [
          { "value": "overlay", "label": "On top of the image" },
          { "value": "below", "label": "Below the image" }
        ],
        "default": "overlay"
      },
      {
        "type": "color",
        "id": "overlay_color",
        "label": "Image overlay color",
        "info": "Only used when title is on top of the image, to keep text readable.",
        "default": "#000000"
      },
      {
        "type": "range",
        "id": "overlay_opacity",
        "label": "Image overlay opacity",
        "min": 0,
        "max": 80,
        "step": 5,
        "unit": "%",
        "default": 30
      },
      {
        "type": "color",
        "id": "card_title_color",
        "label": "Collection title color",
        "info": "Defaults to white when the title is on the image, or your text color when below."
      },
      {
        "type": "select",
        "id": "card_title_size",
        "label": "Collection title size",
        "options": [
          { "value": "small", "label": "Small (16px)" },
          { "value": "medium", "label": "Medium (20px)" },
          { "value": "large", "label": "Large (28px)" }
        ],
        "default": "medium"
      },
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color",
        "id": "background",
        "label": "Section background"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Section heading color"
      },
      {
        "type": "color",
        "id": "divider_color",
        "label": "Divider color",
        "info": "Only visible when \"Show section divider\" is on."
      }
    ],
    "presets": [{
      "name": "Collection list",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }],
    "blocks": [
      {
        "type": "collection",
        "name": "Collection",
        "settings": [
          {
            "id": "collection",
            "type": "collection",
            "label": "Collection"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          },
          {
            "type": "select",
            "id": "focal_point",
            "label": "Focal point",
            "info": "Used to keep the subject of your photo in view.",
            "default": "center center",
            "options": [
              {
                "value": "20% 0",
                "label": "Top left"
              },
              {
                "value": "top center",
                "label": "Top center"
              },
              {
                "value": "80% 0",
                "label": "Top right"
              },
              {
                "value": "20% 50%",
                "label": "Left"
              },
              {
                "value": "center center",
                "label": "Center"
              },
              {
                "value": "80% 50%",
                "label": "Right"
              },
              {
                "value": "20% 100%",
                "label": "Bottom left"
              },
              {
                "value": "bottom center",
                "label": "Bottom center"
              },
              {
                "value": "80% 100%",
                "label": "Bottom right"
              }
            ]
          }
        ]
      }
    ]
  }
{% endschema %}
